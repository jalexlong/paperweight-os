#!/bin/sh
set -e

case "$1" in
    configure)
        if [ -f /etc/default/grub ]; then
            if grep -q "^GRUB_GFXMODE=" /etc/default/grub; then
                sed -i 's|^GRUB_GFXMODE=.*|GRUB_GFXMODE=1366x768,auto|' /etc/default/grub
            else
                echo 'GRUB_GFXMODE=1366x768,auto' >> /etc/default/grub
            fi

            if grep -q "^GRUB_GFXPAYLOAD_LINUX=" /etc/default/grub; then
                sed -i 's|^GRUB_GFXPAYLOAD_LINUX=.*|GRUB_GFXPAYLOAD_LINUX=keep|' /etc/default/grub
            else
                echo 'GRUB_GFXPAYLOAD_LINUX=keep' >> /etc/default/grub
            fi

            if command -v update-grub > /dev/null 2>&1; then
                update-grub || true
            fi
        fi

        # Pre-0.1.14 15-chromebook-input.conf set repeat_delay 200, which
        # caused accidental repeated keys. Replace the user's copy only if
        # it's byte-identical to that single old stock version, so edits
        # are kept. $SUDO_USER for `sudo apt`, else UID 1000.
        TARGET_USER=""
        if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
            TARGET_USER="$SUDO_USER"
        else
            TARGET_USER=$(getent passwd 1000 2>/dev/null | cut -d: -f1 || true)
        fi
        if [ -n "$TARGET_USER" ]; then
            TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
            INPUT_CONF="$TARGET_HOME/.config/sway/config.d/15-chromebook-input.conf"
            OLD_SHA=1695c2afc9336449fd11e3e420f8087186944167703a508f44452374c58aa6f9
            if [ -f "$INPUT_CONF" ] && \
               [ "$(sha256sum "$INPUT_CONF" | cut -d' ' -f1)" = "$OLD_SHA" ]; then
                cp /etc/skel/.config/sway/config.d/15-chromebook-input.conf "$INPUT_CONF"
                chown "${TARGET_USER}:" "$INPUT_CONF" 2>/dev/null || true
            fi
        fi
        ;;
esac

#DEBHELPER#
