// PaperweightOS Plymouth theme — Catppuccin Macchiato
Window.SetBackgroundTopColor(0.141, 0.153, 0.227);
Window.SetBackgroundBottomColor(0.141, 0.153, 0.227);

logo_image = Image("logo.png");
logo = Sprite();
logo.SetImage(logo_image);

label_image = Image.Text("PaperweightOS", 0.647, 0.678, 0.796, 1);
label = Sprite();
label.SetImage(label_image);

rock_image = Image("rock.png");
rock0 = Sprite(); rock0.SetImage(rock_image);
rock1 = Sprite(); rock1.SetImage(rock_image);
rock2 = Sprite(); rock2.SetImage(rock_image);
rock3 = Sprite(); rock3.SetImage(rock_image);
rock4 = Sprite(); rock4.SetImage(rock_image);

fun refresh_callback() {
    cx = Window.GetX() + Window.GetWidth()  / 2;
    cy = Window.GetY() + Window.GetHeight() / 2;

    logo_y = cy - logo_image.GetHeight() / 2 - 60;
    logo.SetX(cx - logo_image.GetWidth()  / 2);
    logo.SetY(logo_y);

    label_y = logo_y + logo_image.GetHeight() + 16;
    label.SetX(cx - label_image.GetWidth() / 2);
    label.SetY(label_y);

    rock_y = label_y + label_image.GetHeight() + 16;
    rock0.SetX(cx - 112 - rock_image.GetWidth() / 2); rock0.SetY(rock_y);
    rock1.SetX(cx -  56 - rock_image.GetWidth() / 2); rock1.SetY(rock_y);
    rock2.SetX(cx        - rock_image.GetWidth() / 2); rock2.SetY(rock_y);
    rock3.SetX(cx +  56 - rock_image.GetWidth() / 2); rock3.SetY(rock_y);
    rock4.SetX(cx + 112 - rock_image.GetWidth() / 2); rock4.SetY(rock_y);

    visible = Math.Int(Plymouth.GetTime()) % 6;
    rock0.SetOpacity(0 < visible ? 1.0 : 0.0);
    rock1.SetOpacity(1 < visible ? 1.0 : 0.0);
    rock2.SetOpacity(2 < visible ? 1.0 : 0.0);
    rock3.SetOpacity(3 < visible ? 1.0 : 0.0);
    rock4.SetOpacity(4 < visible ? 1.0 : 0.0);
}

Plymouth.SetRefreshFunction(refresh_callback);
