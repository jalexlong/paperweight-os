// PaperweightOS Plymouth theme - Catppuccin Frappe
Window.SetBackgroundTopColor(0.188, 0.204, 0.275);
Window.SetBackgroundBottomColor(0.188, 0.204, 0.275);

logo_image = Image("logo.png");
rock_image = Image("rock.png");
label_image = Image.Text("PaperweightOS", 0.647, 0.678, 0.808, 1);

logo_w = 0;
logo_h = 0;
rock_w = 0;
label_w = 0;
label_h = 0;

if (logo_image)  { logo_w = logo_image.GetWidth();  logo_h = logo_image.GetHeight(); }
if (rock_image)  { rock_w = rock_image.GetWidth(); }
if (label_image) { label_w = label_image.GetWidth(); label_h = label_image.GetHeight(); }

logo = Sprite();
if (logo_image)  { logo.SetImage(logo_image); }

label = Sprite();
if (label_image) { label.SetImage(label_image); }

rock0 = Sprite(); if (rock_image) { rock0.SetImage(rock_image); }
rock1 = Sprite(); if (rock_image) { rock1.SetImage(rock_image); }
rock2 = Sprite(); if (rock_image) { rock2.SetImage(rock_image); }
rock3 = Sprite(); if (rock_image) { rock3.SetImage(rock_image); }
rock4 = Sprite(); if (rock_image) { rock4.SetImage(rock_image); }

tick = 0;
step = 0;

fun set_rock_opacities() {
    if (step > 0) rock0.SetOpacity(1.0); else rock0.SetOpacity(0.0);
    if (step > 1) rock1.SetOpacity(1.0); else rock1.SetOpacity(0.0);
    if (step > 2) rock2.SetOpacity(1.0); else rock2.SetOpacity(0.0);
    if (step > 3) rock3.SetOpacity(1.0); else rock3.SetOpacity(0.0);
    if (step > 4) rock4.SetOpacity(1.0); else rock4.SetOpacity(0.0);
}

fun refresh_callback() {
    cx = Window.GetX() + Window.GetWidth()  / 2;
    cy = Window.GetY() + Window.GetHeight() / 2;

    logo_y = cy - logo_h / 2 - 60;
    logo.SetX(cx - logo_w / 2);
    logo.SetY(logo_y);

    label_y = logo_y + logo_h + 16;
    label.SetX(cx - label_w / 2);
    label.SetY(label_y);

    rock_y = label_y + label_h + 16;
    rock0.SetX(cx - 112 - rock_w / 2); rock0.SetY(rock_y);
    rock1.SetX(cx -  56 - rock_w / 2); rock1.SetY(rock_y);
    rock2.SetX(cx        - rock_w / 2); rock2.SetY(rock_y);
    rock3.SetX(cx +  56 - rock_w / 2); rock3.SetY(rock_y);
    rock4.SetX(cx + 112 - rock_w / 2); rock4.SetY(rock_y);

    tick = tick + 1;
    if (tick >= 50) {
        tick = 0;
        step = step + 1;
        if (step >= 6)
            step = 0;
    }

    set_rock_opacities();
}

Plymouth.SetRefreshFunction(refresh_callback);
