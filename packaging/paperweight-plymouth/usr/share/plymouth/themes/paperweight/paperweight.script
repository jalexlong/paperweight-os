// PaperweightOS Plymouth theme — Catppuccin Macchiato
// Dark base background, fixed wordmark, three-dot terminal sequence.

// Background: $base #24273a
Window.SetBackgroundTopColor(0.141, 0.153, 0.227);
Window.SetBackgroundBottomColor(0.141, 0.153, 0.227);

// Wordmark: $subtext0 #a5adcb — muted, not blaring
wordmark_image = Image.Text("paperweight", 0.647, 0.678, 0.796, 1);
wordmark = Sprite();
wordmark.SetImage(wordmark_image);

// Three dots: $lavender #b7bdf8
dot1_image = Image.Text("●", 0.718, 0.741, 0.973, 1);
dot2_image = Image.Text("●", 0.718, 0.741, 0.973, 1);
dot3_image = Image.Text("●", 0.718, 0.741, 0.973, 1);
dot1 = Sprite(); dot1.SetImage(dot1_image);
dot2 = Sprite(); dot2.SetImage(dot2_image);
dot3 = Sprite(); dot3.SetImage(dot3_image);

angle = 0;
pi = 3.14159265;

fun clamp(v, lo, hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

fun dot_opacity(phase) {
    // Sin wave offset by phase; map [-1,1] → [0.15, 1.0]
    raw = Math.Sin(angle * 2 + phase);
    return clamp(0.575 + 0.425 * raw, 0.15, 1.0);
}

fun refresh_callback() {
    angle += 0.07;

    cx = Window.GetX() + Window.GetWidth()  / 2;
    cy = Window.GetY() + Window.GetHeight() / 2;

    // Wordmark centered, slightly above middle
    wordmark.SetX(cx - wordmark_image.GetWidth()  / 2);
    wordmark.SetY(cy - wordmark_image.GetHeight() / 2 - 24);

    // Dots spaced 20px apart, centered, 16px below wordmark
    dot_y = cy + wordmark_image.GetHeight() / 2 - 8;
    spacing = 20;
    dot1.SetX(cx - spacing - dot1_image.GetWidth() / 2);
    dot2.SetX(cx             - dot2_image.GetWidth() / 2);
    dot3.SetX(cx + spacing   - dot3_image.GetWidth() / 2);
    dot1.SetY(dot_y); dot2.SetY(dot_y); dot3.SetY(dot_y);

    // Each dot offset by 120° (2π/3) so they sequence left-to-right
    dot1.SetOpacity(dot_opacity(0));
    dot2.SetOpacity(dot_opacity(2 * pi / 3));
    dot3.SetOpacity(dot_opacity(4 * pi / 3));
}

Plymouth.SetRefreshFunction(refresh_callback);
