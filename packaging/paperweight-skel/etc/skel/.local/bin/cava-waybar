#!/usr/bin/env python3
"""Pipe cava raw output to waybar as Unicode bar characters."""

import configparser
import json
import os
import subprocess
import sys

BLOCKS = " ▁▂▃▄▅▆▇█"
CONF = os.path.expanduser("~/.config/cava/waybar-config")

# Read bars count from the same config cava uses so they stay in sync.
_cfg = configparser.ConfigParser()
_cfg.read(CONF)
BARS = _cfg.getint("general", "bars", fallback=10)

proc = subprocess.Popen(
    ["cava", "-p", CONF],
    stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL,
)

SILENCE_FRAMES = 30  # ~1 s at 30 fps before hiding

try:
    silence = 0
    while True:
        frame = proc.stdout.read(BARS)
        if len(frame) < BARS:
            break
        if all(b == 0 for b in frame):
            silence += 1
        else:
            silence = 0
        if silence >= SILENCE_FRAMES:
            print(json.dumps({"text": ""}), flush=True)
        else:
            text = "".join(BLOCKS[b * 8 // 256] for b in frame)
            print(json.dumps({"text": text}), flush=True)
except (KeyboardInterrupt, BrokenPipeError):
    pass
finally:
    proc.terminate()
