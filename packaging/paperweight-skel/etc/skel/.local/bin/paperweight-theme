#!/bin/sh
# Apply a PaperweightOS color theme atomically.
# Usage: paperweight-theme [<name>]
#
# Theme files live in:
#   ~/.config/sway/themes/<name>.conf          ← sway color variables
#   ~/.config/waybar/themes/<name>-palette.css ← CSS @define-color palette
#   ~/.config/waybar/themes/<name>-waybar.css  ← waybar module styles
#   ~/.config/swaync/themes/<name>.css
#   ~/.config/gtklock/themes/<name>.css
#   ~/.config/foot/themes/<name>.ini
#
# With no argument, prompts via wofi.

SWAY_THEMES="$HOME/.config/sway/themes"
WAYBAR_THEMES="$HOME/.config/waybar/themes"
SWAYNC_THEMES="$HOME/.config/swaync/themes"
GTKLOCK_THEMES="$HOME/.config/gtklock/themes"
WOFI_THEMES="$HOME/.config/wofi/themes"
FOOT_THEMES="$HOME/.config/foot/themes"

list_themes() {
    for f in "$SWAY_THEMES"/*.conf; do
        [ -f "$f" ] || continue
        basename "$f" .conf
    done
}

if [ -n "$1" ]; then
    THEME="$1"
else
    THEME=$(list_themes | wofi --dmenu --prompt "Theme:" --lines 8)
fi

[ -z "$THEME" ] && exit 0

# Validate all theme files exist before touching anything — prevents partial state.
missing=""
for f in \
    "$SWAY_THEMES/$THEME.conf" \
    "$WAYBAR_THEMES/$THEME-palette.css" \
    "$WAYBAR_THEMES/$THEME-waybar.css" \
    "$SWAYNC_THEMES/$THEME.css" \
    "$GTKLOCK_THEMES/$THEME.css" \
    "$WOFI_THEMES/$THEME.css" \
    "$FOOT_THEMES/$THEME.ini"
do
    [ -f "$f" ] || missing="$missing\n  $f"
done
if [ -n "$missing" ]; then
    notify-send -u critical "paperweight-theme" \
        "Theme '$THEME' is incomplete — missing:$missing"
    exit 1
fi

# Apply sway color variables
cp "$SWAY_THEMES/$THEME.conf" "$HOME/.config/sway/config.d/90-colors.conf"

# Apply waybar palette + module styles
printf '@import url("./themes/%s-palette.css");\n@import url("./themes/%s-waybar.css");\n' \
    "$THEME" "$THEME" > "$HOME/.config/waybar/style.css"

# Apply swaync, gtklock, wofi, and foot (new foot windows pick up the colors)
cp "$SWAYNC_THEMES/$THEME.css"  "$HOME/.config/swaync/style.css"
cp "$GTKLOCK_THEMES/$THEME.css" "$HOME/.config/gtklock/style.css"
cp "$WOFI_THEMES/$THEME.css"    "$HOME/.config/wofi/style.css"
cp "$FOOT_THEMES/$THEME.ini"    "$HOME/.config/foot/colors.ini"

# Record active theme
mkdir -p "$HOME/.config/paperweight-os"
printf '%s\n' "$THEME" > "$HOME/.config/paperweight-os/active-theme"

# Apply wallpaper: per-theme user override > artwork default > solid color fallback
THEME_WP_FILE="$HOME/.config/paperweight-os/wallpapers/$THEME"
if [ -f "$THEME_WP_FILE" ]; then
    WP=$(cat "$THEME_WP_FILE")
elif [ -f "/usr/share/paperweight-os/wallpapers/${THEME}-wallpaper1.jpg" ]; then
    WP="/usr/share/paperweight-os/wallpapers/${THEME}-wallpaper1.jpg"
else
    WP="/usr/share/paperweight-os/wallpapers/${THEME}.png"
fi
[ -f "$WP" ] && swaymsg "output * bg $WP fill"

# Update system surfaces (gtkgreet, GRUB, Plymouth) — only if user is in the
# sudo group, since all three helpers require NOPASSWD sudo. Non-sudo users
# get full user-space theming; system surfaces are just left unchanged.
if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx 'sudo'; then
    sudo paperweight-set-greeter-theme "$THEME" 2>/dev/null || true
    sudo paperweight-grub-theme "$THEME" 2>/dev/null || true
    sudo paperweight-plymouth-theme "$THEME" 2>/dev/null || true
fi

# Reload: sway first (color vars), then waybar, then swaync
swaymsg reload
pkill -SIGUSR1 waybar 2>/dev/null || waybar &
swaync-client -rs 2>/dev/null || { pkill -x swaync 2>/dev/null; swaync & }
