// PaperweightOS fastfetch theme — Catppuccin Frappé
// Generated by fastfetch-theme-gen.py from sway/themes/frappe.conf.
// Written by paperweight-theme at runtime; edit this file (or the sway
// palette + regenerate), not the live ~/.config/fastfetch/config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "chafa",
        "source": "~/.config/fastfetch/paperweight-logo.png",
        "width": 18,
        "height": 9,
        "preserveAspectRatio": true,
        "padding": { "top": 1, "right": 2 },
        "chafa": { "fgOnly": true }
    },
    "display": {
        "separator": " ",
        "key": { "width": 10 },
        "color": {
            "keys": "1;38;2;186;187;241",
            "output": "38;2;198;208;245",
            "separator": "38;2;98;104;128"
        },
        "percent": {
            "color": {
                "green": "38;2;166;209;137",
                "yellow": "38;2;229;200;144",
                "red": "38;2;231;130;132"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "color": { "user": "1;38;2;140;170;238", "at": "38;2;131;139;167", "host": "1;38;2;186;187;241" }
        },
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "cpu", "key": "CPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "disk", "folders": "/", "key": "Disk" },
        { "type": "localip", "defaultRouteOnly": true, "key": "IP" },
        { "type": "battery", "key": "Battery" }
    ]
}
