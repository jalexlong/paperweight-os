// PaperweightOS fastfetch theme — Catppuccin Macchiato
// Generated by fastfetch-theme-gen.py from sway/themes/macchiato.conf.
// Written by paperweight-theme at runtime; edit this file (or the sway
// palette + regenerate), not the live ~/.config/fastfetch/config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": { "top": 1 },
        "color": { "1": "1;38;2;183;189;248" }
    },
    "display": {
        "separator": " ",
        "key": { "width": 8 },
        "color": {
            "keys": "1;38;2;183;189;248",
            "output": "38;2;202;211;245",
            "separator": "38;2;91;96;120"
        },
        "percent": {
            "color": {
                "green": "38;2;166;218;149",
                "yellow": "38;2;238;212;159",
                "red": "38;2;237;135;150"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "color": { "user": "1;38;2;138;173;244", "at": "38;2;128;135;162", "host": "1;38;2;183;189;248" }
        },
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "cpu", "key": "CPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "disk", "folders": "/", "key": "Disk" },
        { "type": "localip", "defaultRouteOnly": true, "key": "IP" },
        { "type": "battery", "key": "Battery" }
    ]
}
