#!/bin/sh
set -e

case "$1" in
    configure)
        dconf update 2>/dev/null || true

        # greetd takes over VT1; mask getty@tty1 so they don't race.
        systemctl mask getty@tty1.service 2>/dev/null || true

        # Ensure the greeter user exists for greetd — greetd's own postinst
        # should create it, but install ordering can race.
        if ! getent passwd greeter > /dev/null 2>&1; then
            useradd --system --create-home --home-dir /var/lib/greetd \
                    --shell /usr/sbin/nologin \
                    --groups video,input greeter
        fi

        chmod +x /etc/skel/.local/bin/cava-waybar \
                 /etc/skel/.local/bin/paperweight-network \
                 /etc/skel/.local/bin/sway-wait-float \
                 /usr/bin/paperweight-theme \
                 /usr/bin/paperweight-set-greeter-theme \
                 /usr/lib/paperweight-os/start-greeter
        chmod 0440 /etc/sudoers.d/paperweight-greeter

        # Resolve the target user for skel propagation.
        # $SUDO_USER is set for interactive `sudo apt install`.
        # Fall back to UID 1000 for preseed/unattended installs.
        TARGET_USER=""
        if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
            TARGET_USER="$SUDO_USER"
        else
            TARGET_USER=$(getent passwd 1000 2>/dev/null | cut -d: -f1 || true)
        fi

        if [ -n "$TARGET_USER" ]; then
            TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
            if [ -d "$TARGET_HOME" ]; then
                if [ -z "$2" ]; then
                    # Fresh install: copy everything from skel (no-clobber).
                    echo "paperweight-skel: applying configs to $TARGET_HOME"
                    cp -rn /etc/skel/. "$TARGET_HOME/"
                    chown -R "${TARGET_USER}:" \
                        "$TARGET_HOME/.config" \
                        "$TARGET_HOME/.local" 2>/dev/null || true
                else
                    # Upgrade: propagate new theme directories and update
                    # package-maintained scripts that must stay in sync.
                    install -d -m 755 \
                        "$TARGET_HOME/.config/foot/themes" \
                        "$TARGET_HOME/.config/wofi/themes" \
                        "$TARGET_HOME/.config/paperweight-os/bashrc.d"
                    cp -n /etc/skel/.config/foot/themes/* \
                          "$TARGET_HOME/.config/foot/themes/" 2>/dev/null || true
                    cp -n /etc/skel/.config/wofi/themes/* \
                          "$TARGET_HOME/.config/wofi/themes/" 2>/dev/null || true
                    cp -n /etc/skel/.config/foot/colors.ini \
                          "$TARGET_HOME/.config/foot/" 2>/dev/null || true
                    # Always overwrite package-maintained files so they stay
                    # in sync with the installed version.
                    cp /etc/skel/.config/foot/foot.ini \
                       "$TARGET_HOME/.config/foot/foot.ini"
                    cp /etc/skel/.config/waybar/config.jsonc \
                       "$TARGET_HOME/.config/waybar/config.jsonc"
                    cp /etc/skel/.config/paperweight-os/bashrc.d/10-colors.sh \
                       "$TARGET_HOME/.config/paperweight-os/bashrc.d/10-colors.sh"
                    # Remove stale skel copy of paperweight-theme — it now lives
                    # in /usr/bin/ and is managed by dpkg directly.
                    rm -f "$TARGET_HOME/.local/bin/paperweight-theme"
                    chown -R "${TARGET_USER}:" \
                        "$TARGET_HOME/.config/foot" \
                        "$TARGET_HOME/.config/waybar/config.jsonc" \
                        "$TARGET_HOME/.config/wofi/themes" \
                        "$TARGET_HOME/.config/paperweight-os/bashrc.d" \
                        2>/dev/null || true
                fi

                # Wire up bashrc.d source loop — works on any .bashrc, including
                # stripped ones. The grep guard makes this idempotent on upgrades.
                if [ -f "$TARGET_HOME/.bashrc" ] && \
                   ! grep -q "paperweight-os/bashrc.d" "$TARGET_HOME/.bashrc"; then
                    printf '\n# PaperweightOS bash fragments\nfor _pw in ~/.config/paperweight-os/bashrc.d/*.sh; do [ -f "$_pw" ] && . "$_pw"; done\nunset _pw\n' \
                        >> "$TARGET_HOME/.bashrc"
                    chown "${TARGET_USER}:" "$TARGET_HOME/.bashrc" 2>/dev/null || true
                fi
            fi
        fi

        # Ensure new users created by adduser are placed in the video group
        # so brightnessctl works without sudo.
        if [ -f /etc/adduser.conf ]; then
            # Enable ADD_EXTRA_GROUPS (uncomment or set to 1)
            if grep -q "^#.*ADD_EXTRA_GROUPS" /etc/adduser.conf; then
                sed -i 's/^#\s*ADD_EXTRA_GROUPS.*/ADD_EXTRA_GROUPS=1/' /etc/adduser.conf
            elif ! grep -q "^ADD_EXTRA_GROUPS=" /etc/adduser.conf; then
                echo "ADD_EXTRA_GROUPS=1" >> /etc/adduser.conf
            else
                sed -i 's/^ADD_EXTRA_GROUPS=.*/ADD_EXTRA_GROUPS=1/' /etc/adduser.conf
            fi

            # Add video to EXTRA_GROUPS if not already present
            if grep -q "^EXTRA_GROUPS=" /etc/adduser.conf; then
                if ! grep -qE "^EXTRA_GROUPS=.*\bvideo\b" /etc/adduser.conf; then
                    sed -i 's/^EXTRA_GROUPS="\(.*\)"/EXTRA_GROUPS="\1 video"/' /etc/adduser.conf
                fi
            elif grep -q "^#.*EXTRA_GROUPS" /etc/adduser.conf; then
                sed -i 's/^#\s*EXTRA_GROUPS.*/EXTRA_GROUPS="video"/' /etc/adduser.conf
            else
                echo 'EXTRA_GROUPS="video"' >> /etc/adduser.conf
            fi
        fi
        ;;
esac

#DEBHELPER#
