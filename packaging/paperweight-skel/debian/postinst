#!/bin/sh
set -e

case "$1" in
    configure)
        dconf update 2>/dev/null || true

        # Rebrand /etc/os-release as PaperweightOS. base-files owns this
        # file (Essential package) so we can't ship it directly — patch
        # the display fields in place instead, same pattern used for
        # /etc/adduser.conf below. ID stays "debian" deliberately: tooling
        # that keys off an exact ID match (package-manager detection,
        # VS Code remote-SSH, hardware scripts) should keep working: only
        # the human-facing fields change. VERSION_CODENAME and
        # DEBIAN_VERSION_FULL are left alone — still genuinely Trixie
        # underneath. Distro version is bumped manually at milestones,
        # independent of individual .deb package versions (see CLAUDE.md).
        # Idempotent: safe to re-run on every upgrade. Note: a future
        # base-files upgrade may prompt to keep local vs. maintainer
        # changes to this conffile — expected for this pattern.
        if [ -f /etc/os-release ]; then
            sed -i \
                -e 's/^PRETTY_NAME=.*/PRETTY_NAME="PaperweightOS 0.1"/' \
                -e 's/^NAME=.*/NAME="PaperweightOS"/' \
                -e 's/^VERSION_ID=.*/VERSION_ID="0.1"/' \
                -e 's/^VERSION=.*/VERSION="0.1 (trixie)"/' \
                -e 's#^HOME_URL=.*#HOME_URL="https://github.com/jalexlong/paperweight-os"#' \
                -e 's#^SUPPORT_URL=.*#SUPPORT_URL="https://github.com/jalexlong/paperweight-os/issues"#' \
                -e 's#^BUG_REPORT_URL=.*#BUG_REPORT_URL="https://github.com/jalexlong/paperweight-os/issues"#' \
                /etc/os-release
            if ! grep -q '^ID_LIKE=' /etc/os-release; then
                echo 'ID_LIKE=debian' >> /etc/os-release
            fi
        fi

        # Enable color prompt/aliases and add the bashrc.d fragment loop in
        # /etc/skel/.bashrc. The bash package owns this file (ships it
        # directly), so shipping a competing copy via debian/install causes
        # a dpkg overwrite conflict on unpack — found the hard way. Patch
        # in place instead, same pattern as /etc/os-release above.
        # Idempotent: sed only matches the commented form, so re-running
        # on an already-patched file is a no-op; the bashrc.d append is
        # grep-guarded the same way the existing-user propagation below
        # already does it for a live user's homedir .bashrc.
        if [ -f /etc/skel/.bashrc ]; then
            sed -i \
                -e 's/^#force_color_prompt=yes/force_color_prompt=yes/' \
                -e 's/^\(\s*\)#\(alias grep=\)/\1\2/' \
                -e 's/^\(\s*\)#\(alias fgrep=\)/\1\2/' \
                -e 's/^\(\s*\)#\(alias egrep=\)/\1\2/' \
                -e 's/^#\(alias ll=\)/\1/' \
                -e 's/^#\(alias la=\)/\1/' \
                -e 's/^#\(alias l=\)/\1/' \
                /etc/skel/.bashrc
            if ! grep -q "paperweight-os/bashrc.d" /etc/skel/.bashrc; then
                printf '\n# PaperweightOS bash fragments\nfor _pw in ~/.config/paperweight-os/bashrc.d/*.sh; do [ -f "$_pw" ] && . "$_pw"; done\nunset _pw\n' \
                    >> /etc/skel/.bashrc
            fi
        fi

        # greetd takes over VT1; mask getty@tty1 so they don't race.
        systemctl mask getty@tty1.service 2>/dev/null || true

        # Ensure the greeter user exists for greetd — greetd's own postinst
        # should create it, but install ordering can race.
        if ! getent passwd greeter > /dev/null 2>&1; then
            useradd --system --create-home --home-dir /var/lib/greetd \
                    --shell /usr/sbin/nologin \
                    --groups video,input greeter
        fi

        chmod +x /etc/skel/.local/bin/cava-waybar \
                 /etc/skel/.local/bin/sway-wait-float \
                 /usr/bin/paperweight-theme \
                 /usr/bin/paperweight-network \
                 /usr/bin/paperweight-volume \
                 /usr/bin/paperweight-set-greeter-theme \
                 /usr/lib/paperweight-os/start-greeter
        chmod 0440 /etc/sudoers.d/paperweight-greeter

        # Resolve the target user for skel propagation.
        # $SUDO_USER is set for interactive `sudo apt install`.
        # Fall back to UID 1000 for preseed/unattended installs.
        TARGET_USER=""
        if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
            TARGET_USER="$SUDO_USER"
        else
            TARGET_USER=$(getent passwd 1000 2>/dev/null | cut -d: -f1 || true)
        fi

        if [ -n "$TARGET_USER" ]; then
            TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
            if [ -d "$TARGET_HOME" ]; then
                if [ -z "$2" ]; then
                    # Fresh install: copy everything from skel (no-clobber).
                    echo "paperweight-skel: applying configs to $TARGET_HOME"
                    cp -rn /etc/skel/. "$TARGET_HOME/"
                    chown -R "${TARGET_USER}:" \
                        "$TARGET_HOME/.config" \
                        "$TARGET_HOME/.local" 2>/dev/null || true
                else
                    # Upgrade: propagate new theme directories and update
                    # package-maintained scripts that must stay in sync.
                    install -d -m 755 \
                        "$TARGET_HOME/.config/foot/themes" \
                        "$TARGET_HOME/.config/wofi/themes" \
                        "$TARGET_HOME/.config/wlogout/themes" \
                        "$TARGET_HOME/.config/paperweight-os/bashrc.d" \
                        "$TARGET_HOME/.config/fastfetch/themes"
                    cp -n /etc/skel/.config/foot/themes/* \
                          "$TARGET_HOME/.config/foot/themes/" 2>/dev/null || true
                    cp -n /etc/skel/.config/wofi/themes/* \
                          "$TARGET_HOME/.config/wofi/themes/" 2>/dev/null || true
                    cp -n /etc/skel/.config/foot/colors.ini \
                          "$TARGET_HOME/.config/foot/" 2>/dev/null || true
                    # wlogout config is new — existing users won't have any of
                    # it yet, unlike foot/wofi which just gain new theme files.
                    cp -n /etc/skel/.config/wlogout/themes/* \
                          "$TARGET_HOME/.config/wlogout/themes/" 2>/dev/null || true
                    cp -n /etc/skel/.config/wlogout/layout \
                          "$TARGET_HOME/.config/wlogout/" 2>/dev/null || true
                    cp -n /etc/skel/.config/wlogout/style.css \
                          "$TARGET_HOME/.config/wlogout/" 2>/dev/null || true
                    # fastfetch theme files are entirely package-generated
                    # (fastfetch-theme-gen.py) and never hand-edited, so
                    # always overwrite them — same treatment as foot.ini /
                    # waybar config.jsonc below — to pick up art/color fixes
                    # like the rock-logo redraw on upgrade, not just on the
                    # user's next manual theme switch.
                    cp /etc/skel/.config/fastfetch/themes/*.jsonc \
                       "$TARGET_HOME/.config/fastfetch/themes/" 2>/dev/null || true
                    # Refresh the *active* theme's rendered config.jsonc too,
                    # mirroring what paperweight-theme itself does on switch,
                    # so an in-place upgrade doesn't leave a stale logo/colors
                    # behind until the user happens to reselect their theme.
                    ACTIVE_THEME_FILE="$TARGET_HOME/.config/paperweight-os/active-theme"
                    if [ -f "$ACTIVE_THEME_FILE" ]; then
                        ACTIVE_THEME=$(cat "$ACTIVE_THEME_FILE")
                        if [ -f "/etc/skel/.config/fastfetch/themes/$ACTIVE_THEME.jsonc" ]; then
                            cp "/etc/skel/.config/fastfetch/themes/$ACTIVE_THEME.jsonc" \
                               "$TARGET_HOME/.config/fastfetch/config.jsonc"
                        fi
                    else
                        # Predates active-theme tracking, or a fresh-ish
                        # install that hasn't switched themes yet — don't
                        # clobber a config.jsonc we can't confirm matches.
                        cp -n /etc/skel/.config/fastfetch/config.jsonc \
                              "$TARGET_HOME/.config/fastfetch/" 2>/dev/null || true
                    fi
                    # Always overwrite package-maintained files so they stay
                    # in sync with the installed version.
                    cp /etc/skel/.config/foot/foot.ini \
                       "$TARGET_HOME/.config/foot/foot.ini"
                    cp /etc/skel/.config/waybar/config.jsonc \
                       "$TARGET_HOME/.config/waybar/config.jsonc"
                    cp /etc/skel/.config/paperweight-os/bashrc.d/10-colors.sh \
                       "$TARGET_HOME/.config/paperweight-os/bashrc.d/10-colors.sh"
                    # Remove stale skel copies of scripts that now live in
                    # /usr/bin/ (dpkg-managed) or have been retired outright.
                    # paperweight-power is gone: wlogout replaces it.
                    rm -f "$TARGET_HOME/.local/bin/paperweight-theme" \
                          "$TARGET_HOME/.local/bin/paperweight-network" \
                          "$TARGET_HOME/.local/bin/paperweight-volume" \
                          "$TARGET_HOME/.local/bin/paperweight-power"
                    chown -R "${TARGET_USER}:" \
                        "$TARGET_HOME/.config/foot" \
                        "$TARGET_HOME/.config/waybar/config.jsonc" \
                        "$TARGET_HOME/.config/wofi/themes" \
                        "$TARGET_HOME/.config/wlogout" \
                        "$TARGET_HOME/.config/paperweight-os/bashrc.d" \
                        "$TARGET_HOME/.config/fastfetch" \
                        2>/dev/null || true
                fi

                # Wire up bashrc.d source loop for this specific installing user.
                # The loop is now also baked into etc/skel/.bashrc itself, so any
                # *future* adduser-created user gets it automatically without
                # this postinst ever running again for them — this block exists
                # for upgrades on installs whose .bashrc predates that addition,
                # or any hand-stripped .bashrc missing it. Grep guard makes it
                # idempotent either way.
                if [ -f "$TARGET_HOME/.bashrc" ] && \
                   ! grep -q "paperweight-os/bashrc.d" "$TARGET_HOME/.bashrc"; then
                    printf '\n# PaperweightOS bash fragments\nfor _pw in ~/.config/paperweight-os/bashrc.d/*.sh; do [ -f "$_pw" ] && . "$_pw"; done\nunset _pw\n' \
                        >> "$TARGET_HOME/.bashrc"
                    chown "${TARGET_USER}:" "$TARGET_HOME/.bashrc" 2>/dev/null || true
                fi
            fi
        fi

        # Ensure new users created by adduser are placed in the video group
        # so brightnessctl works without sudo.
        if [ -f /etc/adduser.conf ]; then
            # Enable ADD_EXTRA_GROUPS (uncomment or set to 1)
            if grep -q "^#.*ADD_EXTRA_GROUPS" /etc/adduser.conf; then
                sed -i 's/^#\s*ADD_EXTRA_GROUPS.*/ADD_EXTRA_GROUPS=1/' /etc/adduser.conf
            elif ! grep -q "^ADD_EXTRA_GROUPS=" /etc/adduser.conf; then
                echo "ADD_EXTRA_GROUPS=1" >> /etc/adduser.conf
            else
                sed -i 's/^ADD_EXTRA_GROUPS=.*/ADD_EXTRA_GROUPS=1/' /etc/adduser.conf
            fi

            # Add video to EXTRA_GROUPS if not already present
            if grep -q "^EXTRA_GROUPS=" /etc/adduser.conf; then
                if ! grep -qE "^EXTRA_GROUPS=.*\bvideo\b" /etc/adduser.conf; then
                    sed -i 's/^EXTRA_GROUPS="\(.*\)"/EXTRA_GROUPS="\1 video"/' /etc/adduser.conf
                fi
            elif grep -q "^#.*EXTRA_GROUPS" /etc/adduser.conf; then
                sed -i 's/^#\s*EXTRA_GROUPS.*/EXTRA_GROUPS="video"/' /etc/adduser.conf
            else
                echo 'EXTRA_GROUPS="video"' >> /etc/adduser.conf
            fi
        fi
        ;;
esac

#DEBHELPER#
