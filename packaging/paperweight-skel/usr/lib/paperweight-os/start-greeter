#!/bin/sh
# Create XDG_RUNTIME_DIR for the greeter user — systemd-logind does not
# create it for system users (UID < 1000) without an explicit PAM session.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"
cd "${HOME:-/var/lib/greetd}" 2>/dev/null || cd /tmp

# Force GTK4 Wayland backend — without this GTK4 may attempt X11.
export GDK_BACKEND=wayland
export XDG_DATA_DIRS=/usr/local/share:/usr/share

exec cage -s -- gtkgreet -l -c sway -s /etc/greetd/gtkgreet.css
