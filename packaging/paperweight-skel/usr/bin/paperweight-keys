#!/bin/sh
# paperweight-keys — list the sway keybindings that are actually in effect.
# Usage: paperweight-keys [-p|--print]
#
# Reads ~/.config/sway/config and ~/.config/sway/config.d/*.conf (the same
# files sway includes, in the same order), so the list always matches the
# live config. Shown in wofi by default; -p prints to stdout instead.
#
# Labels come from `#:` comments in the config:
#   #: Open a terminal                  labels the bindsym right below it
#   #: Super+1…0 | Switch workspace     a standalone row for a group
# A binding with no label of its own borrows the label from the identical
# line in /etc/skel, so older configs get labels too. Unlabeled lines that
# match /etc/skel exactly are hidden (e.g. the per-key focus/move lines a
# group row covers). Bindings you added yourself show their command.
# A later binding for the same keys replaces an earlier one, as in sway.

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sway"
SKEL_DIR=/etc/skel/.config/sway

PRINT=0
case "${1:-}" in
    -p|--print) PRINT=1 ;;
    -h|--help)  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "") ;;
    *) echo "usage: paperweight-keys [-p|--print]" >&2; exit 2 ;;
esac

# Build "skel=<counterpart> <file>" argument pairs for awk.
ARGS=""
add() {
    [ -f "$1" ] || return 0
    rel=${1#"$CONF_DIR"/}
    ARGS="$ARGS
skel=$SKEL_DIR/$rel
$1"
}
add "$CONF_DIR/config"
for f in "$CONF_DIR"/config.d/*.conf; do add "$f"; done
[ -n "$ARGS" ] || { echo "paperweight-keys: no sway config found in $CONF_DIR" >&2; exit 1; }

LIST=$(printf '%s\n' "$ARGS" | sed '1d' | tr '\n' '\0' | xargs -0 awk '
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }

# Remember every bindsym line in the /etc/skel counterpart, its label, and
# any group row ("Keys | Description") that sits right above it.
function loadskel(path,    line, l, label, group) {
    for (k in SKEL) delete SKEL[k]
    for (k in SKEL_LABEL) delete SKEL_LABEL[k]
    for (k in SKEL_GROUP) delete SKEL_GROUP[k]
    label = ""; group = ""
    while ((getline line < path) > 0) {
        l = trim(line)
        if (l ~ /^#:/) {
            if (index(l, "|")) group = trim(substr(l, 3)); else label = trim(substr(l, 3))
            continue
        }
        if (l ~ /^#/) continue
        if (l ~ /^bindsym[ \t]/) {
            SKEL[l] = 1
            if (label != "") SKEL_LABEL[l] = label
            if (group != "") SKEL_GROUP[l] = group
        }
        label = ""; group = ""
    }
    close(path)
}

function group_row(a,    i) {
    i = index(a, "|")
    emit("group " tolower(trim(substr(a, 1, i - 1))), trim(substr(a, 1, i - 1)), trim(substr(a, i + 1)))
}

# "$mod+Shift+t" -> "Super+Shift+T"
function pretty(keys,    n, part, i, p, out) {
    n = split(keys, part, "+")
    out = ""
    for (i = 1; i <= n; i++) {
        p = part[i]
        if (p ~ /^\$/ && (p in VAR)) p = VAR[p]
        lp = tolower(p)
        if (lp == "mod4") p = "Super"
        else if (lp == "mod1") p = "Alt"
        else if (lp == "ctrl" || lp == "control") p = "Ctrl"
        else if (lp == "shift") p = "Shift"
        else if (lp == "return") p = "Enter"
        else if (lp == "escape") p = "Esc"
        else if (lp == "space") p = "Space"
        else if (lp == "comma") p = ","
        else if (lp == "period") p = "."
        else if (lp == "minus") p = "-"
        else if (lp == "slash") p = "/"
        else if (length(p) == 1) p = toupper(p)
        out = out (out == "" ? "" : "+") p
    }
    return out
}

function emit(id, keys, desc) {
    if (!(id in POS)) { POS[id] = ++N; }
    KEYS[POS[id]] = keys
    DESC[POS[id]] = desc
}

FNR == 1 { loadskel(skel); label = ""; hadgroup = 0; inmode = 0 }

{ l = trim($0) }

l ~ /^set[ \t]+\$/ {
    split(l, w, /[ \t]+/)
    v = l; sub(/^set[ \t]+\$[^ \t]+[ \t]+/, "", v)
    VAR[w[2]] = v
    next
}

# Bindings inside a mode block only apply in that mode: skip them.
l ~ /^mode[ \t].*\{$/ { inmode = 1; next }
inmode { if (l == "}") inmode = 0; next }

l ~ /^#:/ {
    a = trim(substr(l, 3))
    if (index(a, "|")) { group_row(a); hadgroup = 1; label = "" }
    else label = a
    next
}
l ~ /^#/ { next }
l == "" { label = ""; hadgroup = 0; next }

l ~ /^bindsym[ \t]/ {
    desc = label; label = ""
    if (!hadgroup && (l in SKEL_GROUP)) group_row(SKEL_GROUP[l])
    hadgroup = 0
    if (desc == "" && (l in SKEL_LABEL)) desc = SKEL_LABEL[l]
    n = split(l, w, /[ \t]+/)
    i = 2; while (i <= n && w[i] ~ /^--/) i++
    keys = pretty(w[i])
    if (desc == "") {
        if (l in SKEL) next              # stock and deliberately unlabeled
        cmd = l
        sub(/^bindsym[ \t]+/, "", cmd)
        while (cmd ~ /^--/) sub(/^--[^ \t]+[ \t]+/, "", cmd)
        sub(/^[^ \t]+[ \t]+/, "", cmd)   # drop the key combo
        sub(/^exec[ \t]+/, "", cmd)
        sub(/[ \t]*\\$/, " …", cmd)
        desc = cmd
    }
    emit("key " tolower(keys), keys, desc)
    next
}

{ label = ""; hadgroup = 0 }

END {
    width = 0
    for (i = 1; i <= N; i++) if (length(KEYS[i]) > width) width = length(KEYS[i])
    for (i = 1; i <= N; i++) printf "%-" width "s   %s\n", KEYS[i], DESC[i]
}
')

[ -n "$LIST" ] || exit 0

if [ "$PRINT" = 1 ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    printf '%s\n' "$LIST"
else
    # Read-only reference: typing filters the list, Enter/Esc closes it.
    printf '%s\n' "$LIST" | wofi --dmenu --prompt "Keys:" --lines 16 --width 640 >/dev/null
fi
