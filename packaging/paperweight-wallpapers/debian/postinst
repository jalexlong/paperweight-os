#!/bin/sh
set -e

case "$1" in
    configure)
        chmod +x /etc/skel/.local/bin/paperweight-wallpaper

        # On fresh install, copy skel files to the invoking user's home.
        # $SUDO_USER is set when running interactive `sudo apt install`.
        # Falls back to UID 1000 for preseed/unattended installs.
        if [ -z "$2" ]; then
            TARGET_USER=""
            if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
                TARGET_USER="$SUDO_USER"
            else
                TARGET_USER=$(getent passwd 1000 2>/dev/null | cut -d: -f1 || true)
            fi

            if [ -n "$TARGET_USER" ]; then
                TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
                if [ -d "$TARGET_HOME" ]; then
                    echo "paperweight-wallpapers: applying configs to $TARGET_HOME"
                    install -d -m 755 -o "$TARGET_USER" \
                        "$TARGET_HOME/.config/sway/config.d" \
                        "$TARGET_HOME/.local/bin"
                    cp -n /etc/skel/.config/sway/config.d/91-wallpaper.conf \
                          "$TARGET_HOME/.config/sway/config.d/" 2>/dev/null || true
                    cp -n /etc/skel/.config/sway/config.d/92-wallpaper-picker.conf \
                          "$TARGET_HOME/.config/sway/config.d/" 2>/dev/null || true
                    cp -n /etc/skel/.local/bin/paperweight-wallpaper \
                          "$TARGET_HOME/.local/bin/" 2>/dev/null || true
                    chmod +x "$TARGET_HOME/.local/bin/paperweight-wallpaper" \
                          2>/dev/null || true
                    chown "${TARGET_USER}:" \
                        "$TARGET_HOME/.config/sway/config.d/91-wallpaper.conf" \
                        "$TARGET_HOME/.config/sway/config.d/92-wallpaper-picker.conf" \
                        "$TARGET_HOME/.local/bin/paperweight-wallpaper" \
                        2>/dev/null || true
                fi
            fi
        fi
        ;;
esac

#DEBHELPER#
