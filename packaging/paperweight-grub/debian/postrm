#!/bin/sh
set -e

case "$1" in
    remove|purge)
        if [ -f /etc/default/grub ]; then
            sed -i '/^GRUB_THEME=.*paperweight/d' /etc/default/grub
            if command -v update-grub > /dev/null 2>&1; then
                update-grub || true
            fi
        fi
        ;;
esac

#DEBHELPER#
