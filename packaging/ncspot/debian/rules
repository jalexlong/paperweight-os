#!/usr/bin/make -f

NCSPOT_VERSION = 1.3.4
URL = https://github.com/hrkfdn/ncspot/releases/download/v$(NCSPOT_VERSION)/ncspot-v$(NCSPOT_VERSION)-linux-x86_64.tar.gz

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	curl -fsSL $(URL) | tar -xz ncspot

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 ncspot debian/ncspot/usr/bin/ncspot
