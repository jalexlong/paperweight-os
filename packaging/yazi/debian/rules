#!/usr/bin/make -f

YAZI_VERSION = 26.5.6
URL = https://github.com/sxyazi/yazi/releases/download/v$(YAZI_VERSION)/yazi-x86_64-unknown-linux-musl.deb

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	curl -fsSL $(URL) -o yazi-upstream.deb
	dpkg-deb --extract yazi-upstream.deb upstream-extract

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 upstream-extract/usr/bin/yazi debian/yazi/usr/bin/yazi
	install -Dm755 upstream-extract/usr/bin/ya   debian/yazi/usr/bin/ya
	install -Dm644 upstream-extract/usr/share/bash-completion/completions/yazi \
		debian/yazi/usr/share/bash-completion/completions/yazi
	install -Dm644 upstream-extract/usr/share/bash-completion/completions/ya \
		debian/yazi/usr/share/bash-completion/completions/ya

override_dh_shlibdeps:
	# musl binary — statically linked, no shared lib deps to resolve
