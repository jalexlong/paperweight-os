#!/bin/sh
# One-time interactive setup for the PaperweightOS secrets stack
# (pass + pass-secret-service + pam-gnupg). Run from a terminal.
#
# This script never generates GPG key material itself — key generation
# needs the user's own passphrase and entropy, so it's left to
# `gpg --full-generate-key`. Everything mechanical after that (keygrip
# export, gpg-agent.conf, pass init) is handled here, idempotently.
set -e

GNUPGHOME="${GNUPGHOME:-$HOME/.gnupg}"

LOG_DIR="$HOME/.local/share/paperweight-os"
LOG="$LOG_DIR/secrets-init.log"
mkdir -p "$LOG_DIR"
touch "$LOG"
chmod 600 "$LOG"
log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }
if [ "$(wc -l < "$LOG")" -gt 1000 ]; then
    tail -n 800 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

log "started"

echo "PaperweightOS secrets setup"
echo "==========================="

if ! gpg --list-secret-keys --with-colons 2>/dev/null | grep -q '^sec'; then
    log "no secret key found — exiting, told user to run gpg --full-generate-key"
    echo
    echo "No GPG secret key found. Generate one now:"
    echo
    echo "    gpg --full-generate-key"
    echo
    echo "Then re-run: paperweight-secrets-init"
    exit 1
fi

KEY_ID=$(gpg --list-secret-keys --with-colons | awk -F: '/^sec/ { print $5; exit }')
log "using key: $KEY_ID"
echo "Using GPG key: $KEY_ID"

# ~/.gnupg must be 700 and gpg-agent.conf 600, or gpg will refuse/warn.
mkdir -p "$GNUPGHOME"
chmod 700 "$GNUPGHOME"

AGENT_CONF="$GNUPGHOME/gpg-agent.conf"
touch "$AGENT_CONF"
chmod 600 "$AGENT_CONF"
for directive in \
    "pinentry-program /usr/bin/pinentry-gtk-2" \
    "allow-preset-passphrase" \
    "default-cache-ttl 3600" \
    "max-cache-ttl 86400"
do
    key=$(echo "$directive" | awk '{print $1}')
    if grep -q "^$key" "$AGENT_CONF"; then
        log "gpg-agent.conf: $key already set, left alone"
    else
        echo "$directive" >> "$AGENT_CONF"
        log "gpg-agent.conf: added '$directive'"
    fi
done
gpgconf --reload gpg-agent
log "gpg-agent reloaded"

# Write every keygrip (primary + subkeys) for this key to ~/.pam-gnupg —
# pam-gnupg presets whichever grips it's told to; presetting all of them
# is harmless since they share the same login-derived passphrase.
gpg -K --with-keygrip "$KEY_ID" 2>/dev/null \
    | awk '/Keygrip = / { print $3 }' > "$HOME/.pam-gnupg"
chmod 600 "$HOME/.pam-gnupg"
GRIP_COUNT=$(wc -l < "$HOME/.pam-gnupg")
log "wrote $GRIP_COUNT keygrip(s) to ~/.pam-gnupg"
echo "Wrote $GRIP_COUNT keygrip(s) to ~/.pam-gnupg"

if [ ! -d "$HOME/.password-store" ]; then
    if pass init "$KEY_ID"; then
        log "pass init succeeded"
        echo "Initialized pass store with $KEY_ID"
    else
        STATUS=$?
        log "ERROR: pass init failed (exit $STATUS)"
        echo "pass init failed" >&2
        exit 1
    fi
else
    log "pass store already exists, left alone"
    echo "pass store already exists at ~/.password-store — leaving it alone"
fi

log "done"
echo
echo "Done. Log out and back in for pam-gnupg to start priming gpg-agent"
echo "at login. Use \$mod+p (paperweight-passmenu) to copy a password."
