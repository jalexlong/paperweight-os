#!/bin/sh
# One-way bridge: mirror regular pass(1) entries into a dedicated
# secret_service/cli_mirror/ collection so pass-secret-service (and thus
# any libsecret app) can see them too.
#
# Mirrored entries are symlinks back to the real .gpg files — never copies
# — plus a synthesized .properties sidecar giving each a readable Label.
# pass-secret-service only scans its store once at startup, so this script
# restarts it at the end (best-effort) to pick up changes immediately.
#
# The reverse direction (secrets apps create via D-Bus) needs no bridging:
# they're already regular pass(1) entries under secret_service/<coll>/, and
# paperweight-passmenu already shows them with their D-Bus Label instead of
# the raw id.
#
# Run this after adding CLI passwords you want visible to apps. Safe to
# re-run any time (idempotent) or put on a cron/systemd-timer.
set -e

PREFIX="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
MIRROR="$PREFIX/secret_service/cli_mirror"
COLL_LABEL_KEY='org.freedesktop.Secret.Collection.Label'
ITEM_LABEL_KEY='org.freedesktop.Secret.Item.Label'
ITEM_ATTRS_KEY='org.freedesktop.Secret.Item.Attributes'

if [ ! -d "$PREFIX" ]; then
    echo "No password store at $PREFIX — run paperweight-secrets-init first." >&2
    exit 1
fi

mkdir -p "$MIRROR"

if [ ! -f "$MIRROR/.properties" ]; then
    python3 -c "
import json, sys
json.dump({sys.argv[1]: 'CLI Passwords (pass)'}, open(sys.argv[2], 'w'))
" "$COLL_LABEL_KEY" "$MIRROR/.properties"
fi

# Prune stale mirrors first (source entry deleted since last sync) so the
# summary below reflects the actual end state.
PRUNED=0
for LINK in "$MIRROR"/*.gpg; do
    [ -L "$LINK" ] || continue
    if [ ! -e "$LINK" ]; then
        rm -f "$LINK" "${LINK%.gpg}.properties"
        PRUNED=$((PRUNED + 1))
    fi
done

find "$PREFIX" -type f -name '*.gpg' -not -path "$PREFIX/secret_service/*" | while IFS= read -r GPG; do
    REL=$(printf '%s' "$GPG" | sed -e "s|^$PREFIX/||" -e "s|\.gpg\$||")
    ID=$(printf '%s' "$REL" | sha256sum | cut -c1-32)

    if [ ! -e "$MIRROR/$ID.gpg" ]; then
        ln -s "$GPG" "$MIRROR/$ID.gpg"
    fi
    python3 -c "
import json, sys
json.dump({sys.argv[1]: sys.argv[3], sys.argv[2]: {'pass-path': sys.argv[3]}}, open(sys.argv[4], 'w'))
" "$ITEM_LABEL_KEY" "$ITEM_ATTRS_KEY" "$REL" "$MIRROR/$ID.properties"
done
ACTIVE=$(find "$MIRROR" -name '*.gpg' | wc -l)

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user restart dbus-org.freedesktop.secrets.service 2>/dev/null || true
fi

echo "paperweight-secrets-sync: $ACTIVE active, $PRUNED pruned."
