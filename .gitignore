# Debian build artifacts
# Root-level: apt-get download / dpkg-source scratch files
/*.deb
/*.dsc
/*.buildinfo
/*.changes
/*.xz
/*.gz
packaging/**/*.deb
packaging/**/*.buildinfo
packaging/paperweight-ncspot/ncspot
packaging/paperweight-yazi/yazi-upstream.deb
packaging/paperweight-yazi/upstream-extract/
packaging/**/*.changes
packaging/**/debian/.debhelper/
packaging/**/debian/debhelper-build-stamp
packaging/**/debian/files
packaging/**/debian/*.substvars
packaging/**/debian/tmp/
packaging/**/debian/paperweight-*/

# reprepro generated output (lives on gh-pages branch, not main)
gh-pages/

# live-build working directories and output (large, generated)
live-build/binary/
live-build/chroot/
live-build/cache/
live-build/.build/
live-build/config/binary
live-build/config/chroot
live-build/config/common
live-build/config/source
live-build/binary.modified_timestamps
live-build/chroot.files
live-build/chroot.packages.*
live-build/live-image-amd64.contents
live-build/live-image-amd64.files
live-build/live-image-amd64.packages
*.iso

# GPG secrets — never commit these
*.asc
*.gpg.bak
